+// Cached descriptors are later walked by the endpoint/context parser. Check
+// the complete byte graph before publishing it, including each interface's
+// endpoint count and the distinct alternate-zero interface count.
+STATIC BOOLEAN
+XhcValidateConfigDescriptor (CONST VOID *Data, UINTN Bytes)
+{
+  CONST UINT8 *P = Data;
+  BOOLEAN Seen[256] = { FALSE };
+  UINTN Offset, Interfaces = 0, Expected = 0, Endpoints = 0;
+  BOOLEAN HaveInterface = FALSE;
+  if (Bytes < sizeof (EFI_USB_CONFIG_DESCRIPTOR) || P[0] < sizeof (EFI_USB_CONFIG_DESCRIPTOR) ||
+      P[1] != USB_DESC_TYPE_CONFIG || P[0] > Bytes || P[5] == 0) { return FALSE; }
+  for (Offset = P[0]; Offset < Bytes; Offset += P[Offset]) {
+    if (Bytes - Offset < 2 || P[Offset] < 2 || P[Offset] > Bytes - Offset) { return FALSE; }
+    if (P[Offset + 1] == USB_DESC_TYPE_INTERFACE) {
+      if (P[Offset] < sizeof (USB_INTERFACE_DESCRIPTOR) || (HaveInterface && Endpoints != Expected)) { return FALSE; }
+      UINT8 Number = P[Offset + 2];
+      if (P[Offset + 3] == 0) {
+        if (Seen[Number]) { return FALSE; }
+        Seen[Number] = TRUE; Interfaces++;
+      }
+      HaveInterface = TRUE; Expected = P[Offset + 4]; Endpoints = 0;
+    } else if (P[Offset + 1] == USB_DESC_TYPE_ENDPOINT) {
+      if (!HaveInterface || P[Offset] < sizeof (USB_ENDPOINT_DESCRIPTOR) ||
+          !(P[Offset + 2] & 15) || (P[Offset + 2] & 0x70) || ++Endpoints > Expected) { return FALSE; }
+    }
+  }
+  return HaveInterface && Endpoints == Expected && Interfaces == P[4];
+}
+
+STATIC EFI_USB_CONFIG_DESCRIPTOR *
+XhcCachedConfig (USB_DEV_CONTEXT *Device, UINT8 Value)
+{
+  if (Device->ConfDesc == NULL) { return NULL; }
+  for (UINTN Index = 0; Index < Device->DevDesc.NumConfigurations; Index++) {
+    if (Device->ConfDesc[Index] != NULL && Device->ConfDesc[Index]->ConfigurationValue == Value) { return Device->ConfDesc[Index]; }
+  }
+  return NULL;
+}
