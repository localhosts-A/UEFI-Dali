+STATIC EFI_STATUS
+ScsiDiskApplyUfsMediaPolicy (SCSI_DISK_DEV *Device)
+{
+  EFI_HANDLE *Handles;
+  UINTN Count;
+  EFI_STATUS Status = gBS->LocateHandleBuffer (
+    ByProtocol, &gEfiExtScsiPassThruProtocolGuid, NULL, &Count, &Handles);
+  if (Status == EFI_NOT_FOUND) { return EFI_SUCCESS; }
+  if (EFI_ERROR (Status)) { return Status; }
+  Status = EFI_SUCCESS;
+  for (UINTN Index = 0; Index < Count; Index++) {
+    if (EFI_ERROR (EfiTestChildHandle (Handles[Index], Device->Handle, &gEfiExtScsiPassThruProtocolGuid))) { continue; }
+    EDKII_UFS_HC_PLATFORM_PROTOCOL *Platform;
+    Status = gBS->HandleProtocol (Handles[Index], &gEdkiiUfsHcPlatformProtocolGuid, (VOID **)&Platform);
+    if ((Status == EFI_UNSUPPORTED) || (Status == EFI_NOT_FOUND)) { Status = EFI_SUCCESS; break; }
+    if (EFI_ERROR (Status)) { break; }
+    if (Platform->Version < EDKII_UFS_HC_PLATFORM_COMMAND_POLICY_VERSION) { break; }
+    if (Platform->Callback == NULL) { Status = EFI_SECURITY_VIOLATION; break; }
+    EDKII_UFS_HC_MEDIA_POLICY Policy;
+    ZeroMem (&Policy, sizeof Policy);
+    Status = Platform->Callback (Handles[Index], EdkiiUfsHcGetMediaPolicy, &Policy);
+    if (EFI_ERROR (Status)) { break; }
+    if (!Policy.SyncTimeout || Policy.SyncTimeout > SCSI_DISK_TIMEOUT) { Status = EFI_INVALID_PARAMETER; break; }
+    Device->UfsPlatformSync = TRUE;
+    Device->UfsSyncTimeout = Policy.SyncTimeout;
+    if (Policy.ReadOnly) { Device->BlkIo.Media->ReadOnly = TRUE; }
+    break;
+  }
+  gBS->FreePool (Handles);
+  return Status;
+}
