+EFI_STATUS
+ScsiDiskApplyUfsMediaPolicy (
+  IN OUT SCSI_DISK_DEV  *ScsiDiskDevice
+  )
+{
+  EFI_STATUS                          Status;
+  EFI_HANDLE                          *Handles;
+  UINTN                               HandleCount;
+  UINTN                               Index;
+  EFI_HANDLE                          Parent;
+  BOOLEAN                             FoundParent;
+  EDKII_UFS_HC_PLATFORM_PROTOCOL      *Platform;
+  EDKII_UFS_HC_MEDIA_POLICY           Policy;
+
+  if ((ScsiDiskDevice == NULL) || (ScsiDiskDevice->Handle == NULL) || (ScsiDiskDevice->BlkIo.Media == NULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  Handles = NULL;
+  HandleCount = 0;
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEdkiiUfsHcPlatformProtocolGuid, NULL, &HandleCount, &Handles);
+  if (Status == EFI_NOT_FOUND) {
+    return EFI_SUCCESS;
+  }
+
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if ((Handles == NULL) || (HandleCount > 128)) {
+    if (Handles != NULL) {
+      FreePool (Handles);
+    }
+
+    return EFI_SECURITY_VIOLATION;
+  }
+
+  FoundParent = FALSE;
+  Parent = NULL;
+  for (Index = 0; Index < HandleCount; Index++) {
+    Status = EfiTestChildHandle (Handles[Index], ScsiDiskDevice->Handle, &gEfiExtScsiPassThruProtocolGuid);
+    if (Status == EFI_SUCCESS) {
+      if (FoundParent) {
+        FreePool (Handles);
+        return EFI_SECURITY_VIOLATION;
+      }
+
+      Parent = Handles[Index];
+      FoundParent = TRUE;
+    } else if ((Status != EFI_UNSUPPORTED) && (Status != EFI_NOT_FOUND)) {
+      FreePool (Handles);
+      return EFI_ERROR (Status) ? Status : EFI_DEVICE_ERROR;
+    }
+  }
+
+  FreePool (Handles);
+  if (!FoundParent) {
+    return EFI_SUCCESS;
+  }
+
+  Platform = NULL;
+  Status = gBS->HandleProtocol (Parent, &gEdkiiUfsHcPlatformProtocolGuid, (VOID **)&Platform);
+  if ((Status == EFI_UNSUPPORTED) || (Status == EFI_NOT_FOUND)) {
+    return EFI_SUCCESS;
+  }
+
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if ((Platform == NULL) || (Platform->Version < EDKII_UFS_HC_PLATFORM_COMMAND_POLICY_VERSION)) {
+    return EFI_SUCCESS;
+  }
+
+  if (Platform->Callback == NULL) {
+    return EFI_SECURITY_VIOLATION;
+  }
+
+  ZeroMem (&Policy, sizeof (Policy));
+  Status = Platform->Callback (Parent, EdkiiUfsHcGetMediaPolicy, &Policy);
+  if (Status != EFI_SUCCESS) {
+    return EFI_ERROR (Status) ? Status : EFI_DEVICE_ERROR;
+  }
+
+  if ((Policy.SyncTimeout == 0) || (Policy.SyncTimeout > 30000000ULL)) { // Three seconds in 100 ns units.
+    return EFI_INVALID_PARAMETER;
+  }
+
+  ScsiDiskDevice->BlkIo.Media->ReadOnly |= Policy.ReadOnly;
+  ScsiDiskDevice->UfsPlatformSync = TRUE;
+  ScsiDiskDevice->UfsSyncTimeout = Policy.SyncTimeout;
+  return EFI_SUCCESS;
+}
+
+EFI_STATUS
+ScsiDiskUfsSynchronizeCache (
+  IN SCSI_DISK_DEV  *ScsiDiskDevice
+  )
+{
+  EFI_STATUS                          Status;
+  EFI_SCSI_IO_SCSI_REQUEST_PACKET     Packet;
+  UINT8                               Cdb[10];
+  VOID                                *SenseData;
+
+  if ((ScsiDiskDevice == NULL) || !ScsiDiskDevice->UfsPlatformSync) {
+    return EFI_SUCCESS;
+  }
+
+  if ((ScsiDiskDevice->ScsiIo == NULL) || (ScsiDiskDevice->UfsSyncTimeout == 0) ||
+      (ScsiDiskDevice->UfsSyncTimeout > 30000000ULL)) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if ((ScsiDiskDevice->BlkIo.Media == NULL) || !ScsiDiskDevice->BlkIo.Media->MediaPresent) {
+    return EFI_NO_MEDIA;
+  }
+
+  if (!IsListEmpty (&ScsiDiskDevice->AsyncTaskQueue)) {
+    return EFI_NOT_READY;
+  }
+
+  SenseData = AllocateAlignedPages (
+                 EFI_SIZE_TO_PAGES (32),
+                 ScsiDiskDevice->ScsiIo->IoAlign
+                 );
+  if (SenseData == NULL) {
+    return EFI_OUT_OF_RESOURCES;
+  }
+
+  ZeroMem (&Packet, sizeof (Packet));
+  ZeroMem (Cdb, sizeof (Cdb));
+  ZeroMem (SenseData, 32);
+  Cdb[0] = 0x35; // SYNCHRONIZE CACHE(10), no immediate bit and no payload.
+  Packet.Cdb = Cdb;
+  Packet.CdbLength = sizeof (Cdb);
+  Packet.DataDirection = EFI_SCSI_IO_DATA_DIRECTION_READ;
+  Packet.Timeout = ScsiDiskDevice->UfsSyncTimeout;
+  Packet.SenseData = SenseData;
+  Packet.SenseDataLength = 32;
+  Status = ScsiDiskDevice->ScsiIo->ExecuteScsiCommand (ScsiDiskDevice->ScsiIo, &Packet, NULL);
+  FreeAlignedPages (SenseData, EFI_SIZE_TO_PAGES (32));
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  if (Packet.HostAdapterStatus == EFI_SCSI_IO_STATUS_HOST_ADAPTER_TIMEOUT_COMMAND) {
+    return EFI_TIMEOUT;
+  }
+
+  if ((Packet.HostAdapterStatus != EFI_SCSI_IO_STATUS_HOST_ADAPTER_OK) ||
+      (Packet.TargetStatus != EFI_SCSI_IO_STATUS_TARGET_GOOD) ||
+      Packet.InTransferLength || Packet.OutTransferLength ||
+      Packet.InDataBuffer != NULL || Packet.OutDataBuffer != NULL) {
+    return EFI_DEVICE_ERROR;
+  }
+
+  return EFI_SUCCESS;
+}
