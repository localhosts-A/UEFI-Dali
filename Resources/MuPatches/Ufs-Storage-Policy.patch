+    if (AbortStatus != EFI_SUCCESS) {
+      *Retained = TRUE;
+      return AbortStatus;
+    }
+  }
+
+  if (TransReq != NULL) {
+    if (!DataValid && (TransReq->Packet->DataDirection == EFI_EXT_SCSI_DATA_DIRECTION_READ)) {
+      TransReq->Packet->InTransferLength = 0;
+    } else if (!DataValid) {
+      TransReq->Packet->OutTransferLength = 0;
+    }
+
+    CleanupStatus = UfsReconcileDataTransferBuffer (Private, TransReq);
+    if (EFI_ERROR (CleanupStatus)) {
