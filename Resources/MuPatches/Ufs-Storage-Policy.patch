+    return EFI_SECURITY_VIOLATION;
+  }
+
+  Status = mUfsHcPlatform->Callback (Controller, Phase, Data);
+  if (Status == EFI_SUCCESS) {
+    return EFI_SUCCESS;
+  }
+
+  // Policy warnings are not permission to submit a command.
+  return EFI_ERROR (Status) ? Status : EFI_DEVICE_ERROR;
